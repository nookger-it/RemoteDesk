<Window x:Class="RemoteDesk.Operator.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteDesk Operator Client — V1 LAN-First"
        Height="760" Width="1220"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="RemoteScreen_Drop"
        Background="#0F172A" Foreground="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar: API & Connection Controls -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="API URL:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#94A3B8"/>
                    <TextBox x:Name="ApiUrlTextBox" Text="http://localhost:5100" Width="165" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,6,0"/>
                    <Button x:Name="RefreshDevicesBtn" Content="Refresh" Padding="8,6" Margin="0,0,6,0" Click="RefreshDevicesBtn_Click"/>
                    <ComboBox x:Name="DevicesComboBox" Width="205" VerticalContentAlignment="Center" Margin="0,0,4,0" DisplayMemberPath="DisplayLabel"/>
                    <Button x:Name="AddDeviceBtn" Content="+ Add" Padding="7,6" Background="#0D9488" Foreground="White" FontWeight="SemiBold" Margin="0,0,4,0" ToolTip="เพิ่มเครื่องปลายทางด้วยชื่อและ IP Address" Click="AddDeviceBtn_Click"/>
                    <Button x:Name="RenameDeviceBtn" Content="Rename" Padding="7,6" Background="#475569" Foreground="White" Margin="0,0,4,0" ToolTip="แก้ไขชื่อเครื่องที่เลือก" Click="RenameDeviceBtn_Click"/>
                    <Button x:Name="DeleteDeviceBtn" Content="Delete" Padding="7,6" Background="#991B1B" Foreground="White" Margin="0,0,8,0" ToolTip="ลบเครื่องที่เลือกออกจากรายการ" Click="DeleteDeviceBtn_Click"/>
                    <CheckBox x:Name="AllowInputCheckBox" Content="Control Mouse/KB" IsChecked="True" VerticalAlignment="Center" Foreground="#E2E8F0" Margin="0,0,8,0"/>
                    <ComboBox x:Name="QualityComboBox" Width="170" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Change stream quality live" SelectionChanged="QualityComboBox_SelectionChanged">
                        <ComboBoxItem Content="Ultra (Native 95%, 45 FPS)"/>
                        <ComboBoxItem Content="Sharp (Native 88%, 35 FPS)"/>
                        <ComboBoxItem Content="Balanced (900p, 45 FPS)"/>
                        <ComboBoxItem Content="Fast (720p, 60 FPS)"/>
                    </ComboBox>
                    <Button x:Name="ConnectBtn" Content="Connect (LAN)" Padding="10,6" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Margin="0,0,6,0" Click="ConnectBtn_Click"/>
                    <Button x:Name="DisconnectBtn" Content="Disconnect" Padding="10,6" Background="#DC2626" Foreground="White" FontWeight="SemiBold" IsEnabled="False" Margin="0,0,6,0" Click="DisconnectBtn_Click"/>
                    <Button x:Name="SendFileBtn" Content="Send File" Padding="8,6" Background="#059669" Foreground="White" FontWeight="SemiBold" IsEnabled="False" Margin="0,0,6,0" ToolTip="Send a file over encrypted Direct LAN (or drag &amp; drop onto screen)" Click="SendFileBtn_Click"/>
                    <Button x:Name="SnapshotBtn" Content="Snapshot" Padding="8,6" Background="#334155" Foreground="White" IsEnabled="False" Margin="0,0,6,0" Click="SnapshotBtn_Click"/>
                    <Button x:Name="SendClipboardBtn" Content="Paste Text" Padding="8,6" Background="#334155" Foreground="White" IsEnabled="False" Margin="0,0,6,0" ToolTip="Sync and paste clipboard text (Thai/English/Unicode) to Remote PC" Click="SendClipboardBtn_Click"/>
                    <Button x:Name="FullScreenBtn" Content="Full Screen" Padding="8,6" Background="#334155" Foreground="White" Click="FullScreenBtn_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" Text="Status: Ready" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Telemetry Bar -->
        <Border Grid.Row="1" Background="#0B1120" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TransportBadgeText" Text="Mode: Disconnected" Foreground="#22C55E" FontWeight="Bold" Margin="0,0,20,0"/>
                <TextBlock x:Name="TelemetryFpsText" Text="FPS: 0.0" Foreground="#E2E8F0" Margin="0,0,20,0"/>
                <TextBlock x:Name="TelemetryLatencyText" Text="Latency: 0.0 ms" Foreground="#E2E8F0" Margin="0,0,20,0"/>
                <TextBlock x:Name="TelemetryBandwidthText" Text="Bandwidth: 0.0 kbps" Foreground="#E2E8F0" Margin="0,0,20,0"/>
                <TextBlock x:Name="TelemetryFramesText" Text="Frames: 0" Foreground="#94A3B8" Margin="0,0,20,0"/>
                <TextBlock x:Name="TelemetryInputText" Text="Input Events: 0" Foreground="#38BDF8"/>
            </StackPanel>
        </Border>

        <!-- Remote Screen Viewer Canvas -->
        <Border Grid.Row="2" Background="#020617" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" ClipToBounds="True" AllowDrop="True" Drop="RemoteScreen_Drop">
            <Grid>
                <TextBlock x:Name="PlaceholderText"
                           Text="Select an Online Device and click 'Connect (Direct LAN)' to start encrypted real-time screen viewing and input control."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="15"/>
                <Image x:Name="RemoteScreenImage"
                       Stretch="Uniform"
                       Focusable="True"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderOptions.EdgeMode="Aliased"
                       MouseMove="RemoteScreenImage_MouseMove"
                       MouseDown="RemoteScreenImage_MouseDown"
                       MouseUp="RemoteScreenImage_MouseUp"
                       MouseWheel="RemoteScreenImage_MouseWheel"/>
                <Border x:Name="DragDropOverlayBorder"
                        Background="#CC064E3B"
                        BorderBrush="#10B981"
                        BorderThickness="3"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock Text="ปล่อยเมาส์เพื่อส่งไฟล์ไปยังเครื่องปลายทาง (พร้อมคัดลอกเข้า Clipboard ให้กด Ctrl+V วางไฟล์ได้ทันที)"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#ECFDF5"
                               FontSize="18"
                               FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
